{
  "name": "hush-server",
  "version": "0.2.0",
  "private": true,
  "description": "Hush messaging server: WebSocket document store with live subscriptions, SQLite, no address logging.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev.mjs",
    "dev:lan": "node --disable-warning=ExperimentalWarning scripts/dev.mjs --lan",
    "csp": "node scripts/csp-hash.mjs ../index.html",
    "test": "node --disable-warning=ExperimentalWarning --test --test-timeout=120000 \"test/*.test.js\""
  },
  "dependencies": {
    "resend": "^6.32.1",
    "ws": "^8.18.3"
  }
}
