# Caddy in front of the Hush server (SPEC.md 11.3). Replace <domain>.
# No `log` directive in the site: Caddy keeps no access log unless asked to. The global block below also keeps the
# two loggers that print a request's details (the visitor's address, the path, the browser) out of the journal: a
# media download cut short, or a failed request, would otherwise record them.
{
	log default {
		exclude http.handlers.reverse_proxy http.log.error
	}
}

<domain> {
	@notmedia not path /media/*
	encode @notmedia zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), display-capture=(), payment=(), usb=(), serial=(), bluetooth=(), midi=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# The app itself. Caching (SPEC.md 10.6): the page is revalidated on every visit, so a release is picked up at
	# once; the files it pins carry a version in their address (?v=<hash prefix>, written by `npm run csp`), so they
	# can be kept for a year without a returning visitor ever pairing a new page with an old file, which the pins
	# would refuse. The same files without a version are revalidated too.
	@page path / /index.html
	header @page Cache-Control "no-cache"
	@versioned {
		path /app/* /vendor/*
		query v=*
	}
	header @versioned Cache-Control "public, max-age=31536000, immutable"
	@plainfile {
		path /app/* /vendor/*
		not query v=*
	}
	header @plainfile Cache-Control "no-cache"
	# Apple's CDN reads this file to tie the iPhone app to the site, so Apple Passwords can save and fill the Hush
	# login (SPEC.md 12.2). The file has no extension and the site sends nosniff, so its type must be named here.
	header /.well-known/apple-app-site-association Content-Type application/json
	header /.well-known/apple-app-site-association Cache-Control "no-cache"
	root * /srv/hush/www
	file_server

	# A missing file gets the branded page (404.html: plain HTML, no scripts) and keeps its 404 status. Error responses
	# skip the header block above, so this one carries its own copy.
	handle_errors 404 {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			Content-Security-Policy "frame-ancestors 'none'"
			X-Frame-Options "DENY"
			Permissions-Policy "camera=(self), microphone=(self), geolocation=(), display-capture=(), payment=(), usb=(), serial=(), bluetooth=(), midi=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			-Server
		}
		rewrite * /404.html
		file_server
	}

	# Body caps at the edge: a media piece is 1 MiB plus its iv and tag, a drop or wake body under 8 KB, so anything
	# larger is cut off here instead of being read into the service (SPEC.md 11.3).
	@media path /media/*
	request_body @media {
		max_size 2MB
	}
	@small path /drop /wake
	request_body @small {
		max_size 16KB
	}

	# The API. Caddy sets X-Forwarded-For to the peer address it saw and drops a value a public client wrote itself (its default:
	# no trusted_proxies, so no peer may hand one on; a private-range hop placed in front of Caddy would need its own entry,
	# or every user would share that hop's address); the server reads the last hop and uses it only for a salted, in-memory
	# rate-limit tag. /media/* carries encrypted pieces (SPEC.md 7.7): no logging, no caching (the server sends no-store),
	# and no compression, since ciphertext doesn't compress.
	@api path /ws /drop /wake /healthz /media/*
	reverse_proxy @api 127.0.0.1:8080 {
		flush_interval -1
	}
}
